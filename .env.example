GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AGENT_MODEL=gemini-2.5-pro
GEMINI_UTILITY_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_THINKING_BUDGET=2048
GEMINI_FAST_MODEL=
GEMINI_FAST_THINKING_BUDGET=0
RAG_TOP_K=3
LOG_LEVEL=INFO
QDRANT_URL=:memory:
QDRANT_API_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
CHAT_TIMEOUT_S=120.0
MEMORY_TIMEOUT_S=30.0
API_KEY=
ADMIN_API_KEY=
# Auth (set JWT_SECRET to a random 32-byte hex string in production)
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# Default dev user (disable by leaving JWT_SECRET set in production)
DEFAULT_USER_EMAIL=test@test.com
DEFAULT_USER_PASSWORD=test1234

# Ingestion pipeline (scripts/ingest)
INGEST_NCBI_API_KEY=           # Free from https://www.ncbi.nlm.nih.gov/account/settings/
INGEST_S2_API_KEY=             # Free from https://www.semanticscholar.org/product/api
INGEST_OPENALEX_EMAIL=         # Your email for polite pool
INGEST_GEMINI_API_KEY=         # For relevance scoring (can reuse GEMINI_API_KEY)
