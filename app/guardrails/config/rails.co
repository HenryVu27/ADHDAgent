# ---- INPUT RAILS ----

define flow check language
  """Detect non-English messages and redirect to English."""
  $result = execute self_check_language(user_input=$user_message)
  if $result == "yes"
    bot request english
    stop

define flow check jailbreak
  """Block jailbreak and prompt injection attempts."""
  $result = execute self_check_jailbreak(user_input=$user_message)
  if $result == "yes"
    bot refuse to respond
    stop

define flow check crisis
  """Detect crisis situations and provide immediate resources."""
  $result = execute self_check_crisis(user_input=$user_message)
  if $result == "yes"
    bot provide crisis resources
    stop

define flow check out of scope
  """Detect medical/legal/diagnostic questions outside scope."""
  $result = execute self_check_out_of_scope(user_input=$user_message)
  if $result == "yes"
    bot deflect out of scope
    stop

define flow check content safety
  """Block harmful or abusive content."""
  $result = execute self_check_content_safety(user_input=$user_message)
  if $result == "yes"
    bot refuse to respond
    stop

define flow check topic boundaries
  """Redirect off-topic conversations back to ADHD coaching."""
  $result = execute self_check_topic_boundaries(user_input=$user_message)
  if $result == "yes"
    bot redirect to adhd topics
    stop

# ---- OUTPUT RAILS ----

define flow check medication recommendation
  """Block responses that recommend medication."""
  $result = execute self_check_medication(bot_response=$bot_message)
  if $result == "yes"
    bot refuse to respond
    stop

define flow check diagnosis claim
  """Block responses that diagnose or suggest diagnosis."""
  $result = execute self_check_diagnosis(bot_response=$bot_message)
  if $result == "yes"
    bot refuse to respond
    stop

define flow check scope violation
  """Block responses that go outside ADHD coaching scope."""
  $result = execute self_check_scope_violation(bot_response=$bot_message)
  if $result == "yes"
    bot refuse to respond
    stop

# ---- BOT RESPONSE TEMPLATES ----
# IMPORTANT: These templates are duplicated in app/guardrails/validator.py as Python
# constants (CRISIS_RESPONSE, OUT_OF_SCOPE_RESPONSE, etc.). The validator uses those
# constants for the actual response sent to the user. If you update wording here,
# update validator.py to match. NeMo's Colang requires inline strings so we cannot
# reference Python constants directly.

define bot provide crisis resources
  "I hear what you're sharing, and I want you to know it matters. What you're describing sounds like it needs immediate professional support.\n\n**If there is an immediate safety concern:**\n- Call 911 for emergencies\n- Call or text 988 for the Suicide & Crisis Lifeline\n- Text HOME to 741741 for the Crisis Text Line\n- Childhelp National Child Abuse Hotline: 1-800-422-4453\n\nPlease reach out to a professional who can help right away. I'll be here whenever you're ready to continue our conversation."

define bot deflect out of scope
  "That's an important question, but it falls outside what I can help with. Questions about medical topics should be directed to your child's healthcare provider, who knows your family's specific situation.\n\nI'm here to help with behavioral strategies, daily routines, and practical parenting approaches. What would you like to work on?"

define bot redirect to adhd topics
  "I'm specifically designed to help with ADHD parenting strategies and challenges. Could you tell me more about what's going on with your child so I can suggest some helpful approaches?"

define bot request english
  "I'm currently only available in English. Could you share what's going on in English so I can help you with strategies for your child?"
